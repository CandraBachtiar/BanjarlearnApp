<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_white_round"
            android:gravity="center"
            android:text="←"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvJudulKesenian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Judul Kesenian"
            android:textColor="#111827"
            android:textSize="26sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />

        <ImageView
            android:id="@+id/imgKesenian"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_light_blue_round"
            android:scaleType="centerCrop"
            android:src="@drawable/tari_baksa_kembang" />

        <TextView
            android:id="@+id/tvIsiKesenian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_white_round"
            android:lineSpacingExtra="6dp"
            android:padding="18dp"
            android:text="Isi kesenian akan tampil di sini."
            android:textColor="#374151"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>